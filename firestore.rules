rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function creatorBindingExists() {
      return exists(/databases/$(database)/documents/lineageBindings/jhuan);
    }

    function isCreator() {
      return signedIn()
        && creatorBindingExists()
        && get(/databases/$(database)/documents/lineageBindings/jhuan).data.ownerUid == request.auth.uid;
    }

    function ownProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid)/profile/main;
    }

    function profileHasDifferentIdentity(identityId) {
      return exists(ownProfilePath())
        && ('lineageId' in get(ownProfilePath()).data)
        && get(ownProfilePath()).data.lineageId != identityId;
    }

    function ownIdentityClaimExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/userIdentityClaims/$(request.auth.uid));
    }

    function ownIdentityId() {
      return get(/databases/$(database)/documents/userIdentityClaims/$(request.auth.uid)).data.identityId;
    }

    match /lineageBindings/{identityId} {
      // Um membro autenticado precisa conseguir verificar se o nome escolhido
      // já foi reivindicado. Listagem completa fica restrita ao creator.
      allow get: if signedIn();
      allow list: if isCreator();

      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/lineageBindings/$(identityId))
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.identityId == identityId
                    && identityId in ['alef', 'jhuan', 'kauan', 'poliana', 'laerte']
                    && !profileHasDifferentIdentity(identityId)
                    // Jhuan ancora a linhagem; os demais claims só abrem depois.
                    && (identityId == 'jhuan' || creatorBindingExists());

      // O dono pode atualizar metadados sem transferir a identidade para outro UID.
      // O creator mantém a função administrativa para recuperação futura.
      allow update: if signedIn()
                    && request.resource.data.identityId == resource.data.identityId
                    && (
                      (
                        resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid
                      )
                      || isCreator()
                    );

      allow delete: if isCreator();
    }

    match /userIdentityClaims/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isCreator());
      allow list: if isCreator();

      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.ownerUid == userId
                            && request.resource.data.identityId in ['alef', 'jhuan', 'kauan', 'poliana', 'laerte']
                            && exists(/databases/$(database)/documents/lineageBindings/$(request.resource.data.identityId))
                            && get(/databases/$(database)/documents/lineageBindings/$(request.resource.data.identityId)).data.ownerUid == userId;

      allow delete: if signedIn() && (request.auth.uid == userId || isCreator());
    }

    match /lineageConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isCreator();
    }

    match /lineageMessages/{messageId} {
      // Mensagens podem ser lidas pelo destinatário, pelo remetente, por todos
      // quando forem broadcast, e pelo creator para manutenção da linhagem.
      allow get, list: if signedIn()
        && ownIdentityClaimExists()
        && (
          resource.data.recipientId == 'all'
          || resource.data.recipientId == ownIdentityId()
          || resource.data.senderUid == request.auth.uid
          || isCreator()
        );

      allow create: if signedIn()
        && ownIdentityClaimExists()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderIdentityId == ownIdentityId()
        && request.resource.data.recipientId in ['all', 'alef', 'jhuan', 'kauan', 'poliana', 'laerte']
        && request.resource.data.recipientId != ownIdentityId()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;

      // V0.9.2 trata mensagens como registros imutáveis. Exclusão fica com creator.
      allow update: if false;
      allow delete: if isCreator();
    }

    match /users/{userId}/{document=**} {
      // Cada membro escreve somente na própria área. O creator pode ler para
      // manutenção/recuperação, mas não recebe escrita cruzada por esta regra.
      allow read: if signedIn() && (request.auth.uid == userId || isCreator());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
