{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JORDAN",
  "version": "0.13.0",
  "identifier": "com.jhuan.jordan",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JORDAN",
        "width": 1380,
        "height": 860,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
